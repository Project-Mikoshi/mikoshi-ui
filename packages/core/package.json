{
  "name": "@mikoshi/core",
  "version": "0.4.0",
  "type": "module",
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "test": "vitest run",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@config/build": "workspace:*",
    "@config/eslint": "workspace:*",
    "@config/typescript": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.6.2",
    "@types/pluralize": "^0.0.33",
    "eslint": "^9.37.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
